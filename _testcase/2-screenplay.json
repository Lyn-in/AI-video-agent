    "scenes": [
      {
        "id": "s1",
        "location_id": "l1",
        "time_of_day": "晨",
        "summary": "用一次日常的擦肩，把父子之间那条不认识的规矩演示清楚，同时露出父亲在配合这条规矩时的多余动作",
        "present_character_ids": [
          "c1",
          "c2"
        ],
        "beats": [
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平推着拖把走到走廊中段，抬头看了一眼墙上的挂钟，把拖把往左边挪了半米，让出右边刚拖过、已经干了的那半条路。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默背着包从楼梯口上来，从右边那半条路走过去，眼睛盯着手机。"
          },
          {
            "kind": "reaction",
            "character_id": "c2",
            "text": "陈国平低下头继续拖，等脚步声过去了才停手。他侧过身，看着陈默的背影走到走廊尽头。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默在拐角停了半秒，没有回头，拐了出去。"
          },
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平把拖把挪回中间，接着拖右边那半条。"
          }
        ]
      },
      {
        "id": "s2",
        "location_id": "l2",
        "time_of_day": "日",
        "summary": "室友刁难父亲，父亲道歉的熟练程度当着儿子的面暴露出来，逼出儿子的选择",
        "present_character_ids": [
          "c1",
          "c2",
          "c3"
        ],
        "beats": [
          {
            "kind": "action",
            "character_id": "c3",
            "text": "室友拎着一个没系口的垃圾袋，从两步远的地方往桶里扔，袋子撞在桶沿上，果皮和纸盒撒了一地。"
          },
          {
            "kind": "action",
            "character_id": "c3",
            "text": "室友看了一眼地上，绕开那摊东西往前走。"
          },
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平从旁边过来，蹲下去捡。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默从宿舍楼门口出来，看见蹲在地上的人，脚步慢了下来，停在离垃圾桶三米的地方。"
          },
          {
            "kind": "dialogue",
            "character_id": "c3",
            "text": "师傅，那边还有。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "哎，好，马上。"
          },
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平往那边挪了两步，接着捡。他捡得很快，也没有抬头。"
          },
          {
            "kind": "dialogue",
            "character_id": "c3",
            "text": "干净点啊师傅，我们晚上还得从这走。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "对不住对不住，一下就好。"
          },
          {
            "kind": "reaction",
            "character_id": "c1",
            "text": "陈默站在原地没有动。他听着那两声对不住，那语气顺得像说过很多次。"
          },
          {
            "kind": "action",
            "character_id": "c3",
            "text": "室友转过身，看见陈默，朝他扬了扬下巴。"
          },
          {
            "kind": "dialogue",
            "character_id": "c3",
            "text": "走啊，不是要去食堂。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默看着他，没有应。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默走过去，蹲下来，捡起脚边的一个纸盒。"
          },
          {
            "kind": "reaction",
            "character_id": "c2",
            "text": "陈国平的手停了一下，没有看他。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "你走你的。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默没有走，把捡到的东西放进袋子里。"
          },
          {
            "kind": "dialogue",
            "character_id": "c3",
            "text": "你干嘛呢。"
          },
          {
            "kind": "dialogue",
            "character_id": "c1",
            "text": "我爸腰不好，蹲不了太久。"
          },
          {
            "kind": "reaction",
            "character_id": "c3",
            "text": "室友张了张嘴，往后退了半步，手在裤子上蹭了两下。"
          },
          {
            "kind": "reaction",
            "character_id": "c2",
            "text": "陈国平把袋口攥紧了，肩膀塌下去一点。"
          }
        ]
      },
      {
        "id": "s3",
        "location_id": "l3",
        "time_of_day": "昏",
        "summary": "父亲埋怨儿子多事，问题一件都没解决，但第二天两个人都得照常来",
        "present_character_ids": [
          "c1",
          "c2"
        ],
        "beats": [
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平把拖把靠在墙角，脱下工作服挂到钉子上，动作比平时慢。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默站在门口，没进来。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "你何必呢。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默低头看自己的鞋。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "本来挺好的。往后他们看你，跟以前不一样了。"
          },
          {
            "kind": "dialogue",
            "character_id": "c1",
            "text": "那你以后呢。"
          },
          {
            "kind": "action",
            "character_id": "c2",
            "text": "陈国平没有回答，弯腰去拧水桶里的抹布。"
          },
          {
            "kind": "dialogue",
            "character_id": "c2",
            "text": "明天六点半，我还是三楼。"
          },
          {
            "kind": "action",
            "character_id": "c1",
            "text": "陈默点了点头，转身走了两步，又停住。"
          },
          {
            "kind": "dialogue",
            "character_id": "c1",
            "text": "那我七点二十过。"
          },
          {
            "kind": "reaction",
            "character_id": "c2",
            "text": "陈国平拧抹布的手停住了，过了一会儿，接着拧。"
          }
        ]
      }
    ],
    "key_line_options": [
